# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database lokal — berisi data klien (deskripsi order, dsb.), jangan pernah commit
/prisma/*.db
/prisma/*.db-journal

.vercel
.env*

# motion reel scratch output (final video is motion/otak-rental-reel.mp4)
/motion/out/

# gambar kerja sementara (bukan aset aplikasi)
/scratchpad_images/
